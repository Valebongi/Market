graph TB
    subgraph CLIENTE["🌐 CLIENTE"]
        FE["Next.js 15\nFrontend\n:3000"]
    end

    subgraph GATEWAY["🔀 API GATEWAY :8080"]
        GW["Gateway\n• Validación JWT\n• Proxy HTTP\n• Rate Limiting\n• Inyección de headers"]
    end

    subgraph SERVICIOS["⚙️ MICROSERVICIOS"]
        AUTH["🔐 auth-service\n:3001\ndb: davinci_auth\n\nRegistro, Login\nJWT, OAuth\nReset Password"]
        ASSETS["📦 assets-service\n:3002\ndb: davinci_assets\n\nCRUD Activos\nUpload Imágenes\nFiltros y búsqueda"]
        USERS["👤 users-service\n:3003\ndb: davinci_users\n\nPerfiles\nWishlist\nNotif. Settings"]
        MSG["💬 messaging-service\n:3004\ndb: davinci_messaging\n\nSolicitudes\nMensajes\nNotificaciones"]
        DOM["🏷️ domains-service\n:3005\ndb: davinci_domains\n\nDominios y\nCategorías"]
        ADMIN["🛡️ admin-service\n:3006\ndb: davinci_admin\n\nMétricas\nSnapshots\nModeración"]
    end

    subgraph DBS["🗄️ BASES DE DATOS (PostgreSQL 18)"]
        DB1[("davinci_auth")]
        DB2[("davinci_assets")]
        DB3[("davinci_users")]
        DB4[("davinci_messaging")]
        DB5[("davinci_domains")]
        DB6[("davinci_admin")]
    end

    FE -->|"HTTP :8080/api/v1/*\nBearer JWT"| GW

    GW -->|"/auth/*"| AUTH
    GW -->|"/assets/*"| ASSETS
    GW -->|"/users/*"| USERS
    GW -->|"/requests/*"| MSG
    GW -->|"/domains/*"| DOM
    GW -->|"/admin/*"| ADMIN

    AUTH -.->|"POST /users/profiles\n(fire & forget)"| USERS
    MSG -.->|"PATCH /request-count\n(fire & forget)"| ASSETS
    ASSETS -.->|"PATCH /asset-count\n(fire & forget)"| USERS

    AUTH --- DB1
    ASSETS --- DB2
    USERS --- DB3
    MSG --- DB4
    DOM --- DB5
    ADMIN --- DB6

