# ══════════════════════════════════════════════════════════════
# Da Vinci Inventa — Variables de entorno para docker-compose
# Copiar este archivo como .env y completar los valores
# ══════════════════════════════════════════════════════════════

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── JWT ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_32_random_characters
JWT_EXPIRES_IN=7d

# ── Entorno ───────────────────────────────────────────────────
# OBLIGATORIO en producción. Si falta, auth-service devuelve el token de
# reseteo de contraseña en la respuesta de POST /auth/forgot-password.
NODE_ENV=production

# ── URLs públicas ─────────────────────────────────────────────
# URL del frontend visible por el usuario. La usa el CORS del gateway.
FRONTEND_URL=https://tu-dominio.com

# ── BUILD-TIME del frontend ───────────────────────────────────
# Next.js HORNEA estos valores en los chunks del cliente durante `npm run build`.
# Cambiarlos exige reconstruir la imagen del frontend: no alcanza con reiniciar
# el contenedor. Se pasan como `build.args` (ver docker-compose.yml) y solo
# funcionan porque frontend/Dockerfile los declara con ARG.

# URL pública de la API (gateway) — incluye el prefijo /api/v1
NEXT_PUBLIC_API_URL=https://tu-dominio.com/api/v1

# URL pública del sitio — usada en canonical, robots.txt y sitemap.xml
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# URL pública del assets-service (para las URLs de imágenes subidas)
# En producción debe ser HTTPS. En local: http://localhost:3002
ASSETS_PUBLIC_URL=https://tu-dominio.com

# ── Rate limiting (gateway) ───────────────────────────────────
# Límite general: por IP y por grupo de rutas (/auth/*, /assets/*, ...)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Límite estricto anti fuerza bruta, solo sobre /auth/login, /auth/register,
# /auth/forgot-password y /auth/reset-password. Cupo aparte del general.
RATE_LIMIT_AUTH_TTL=60000
RATE_LIMIT_AUTH_MAX=5

# IPs exentas del rate limiting (coma). Poné acá la IP del contenedor/host del
# frontend si Next.js hace fetch server-side al gateway (Server Components):
# si no, todos los visitantes comparten esa única IP y se throttlean entre sí.
RATE_LIMIT_TRUSTED_IPS=

# trust proxy de Express: obligatorio si hay nginx/Caddy delante del gateway,
# si no el throttler ve todas las requests con la IP del reverse proxy.
# 0 = off (default seguro) · 1 = un proxy de confianza · también acepta CIDRs.
# NO lo actives sin proxy real delante: X-Forwarded-For sería falseable.
TRUST_PROXY=1

# ── OAuth (solo si se usa Google/GitHub login) ────────────────
# BUILD-TIME (se hornean en el bundle del cliente; son públicos por diseño):
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# RUNTIME y SECRETO: lo lee el route handler /api/auth/github/callback dentro
# del server de Next.js. NUNCA pasarlo como build arg — quedaría horneado en
# una capa de la imagen y visible con `docker history`.
GITHUB_CLIENT_SECRET=
