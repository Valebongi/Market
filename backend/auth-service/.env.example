PORT=3001

# CRITICO EN PRODUCCION. Con NODE_ENV != production, POST /auth/forgot-password
# devuelve el token de reseteo en el body ("devToken") a cualquiera que conozca
# un email registrado. En produccion SIEMPRE: NODE_ENV=production
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/davinci_auth?schema=public"
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Internal service communication
USERS_SERVICE_URL="http://localhost:3003"
