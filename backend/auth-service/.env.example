PORT=3001

# POST /auth/forgot-password devuelve el token de reseteo en el body ("devToken")
# SOLO si NODE_ENV=development o EXPOSE_RESET_TOKEN=true. Por defecto NO lo expone
# (fail-closed): si ninguna de las dos esta seteada, el token no sale nunca.
# NUNCA setear EXPOSE_RESET_TOKEN en produccion.
NODE_ENV=development
# EXPOSE_RESET_TOKEN=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/davinci_auth?schema=public"
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Internal service communication
USERS_SERVICE_URL="http://localhost:3003"

# Secreto compartido con users-service para la unica llamada servicio-a-servicio
# (POST /api/v1/users/profiles). Se manda en el header `x-internal-token`.
# users-service lo EXIGE en cuanto el tiene su propia INTERNAL_SERVICE_TOKEN:
# setearlo primero aca y despues alla. Mismo valor en los dos servicios.
# Si esta vacio, users-service cae al modo backstop (rechaza toda request que
# traiga headers x-user-* del gateway).
INTERNAL_SERVICE_TOKEN=""

# ─────────────────────────────────────────────────────────────────────
# BOOTSTRAP DEL PRIMER ADMIN  (ver src/modules/auth/admin-bootstrap.service.ts)
#
# Existe porque RegisterDto NO acepta role=admin (y no debe) y
# PATCH /users/:userId/role exige ser admin: sin esto no hay forma de crear
# el primero.
#
# ES DE UN SOLO USO. La ejecucion se registra en la tabla `admin_bootstraps`
# (indice unico sobre una columna constante). Despues del primer arranque estas
# variables quedan INERTES aunque sigan seteadas para siempre: no re-promueven,
# no revierten un cambio de rol hecho desde el panel, y no sirven para volver a
# escalar privilegios. Si ya existe cualquier admin activo, el bootstrap no
# promueve a nadie y se desarma igual.
#
# BOOTSTRAP_ADMIN_EMAIL: email de la cuenta que queda como admin.
BOOTSTRAP_ADMIN_EMAIL=""
#
# BOOTSTRAP_ADMIN_PASSWORD: SOLO se usa si NO existe una cuenta con ese email.
# Si la cuenta ya existe, se ignora por completo — el bootstrap nunca pisa una
# contrasena existente. Minimo 12 caracteres.
# CAMINO RECOMENDADO: registrate normal por la app y seteá SOLO
# BOOTSTRAP_ADMIN_EMAIL. Asi ninguna contrasena pasa nunca por las variables de
# entorno del proveedor (que las guarda en claro y con historial).
# Si la usas: borrala en cuanto el bootstrap haya corrido.
# BOOTSTRAP_ADMIN_PASSWORD=""
#
# BOOTSTRAP_ADMIN_NAME: displayName de la cuenta creada. Opcional; por defecto
# se usa la parte local del email.
# BOOTSTRAP_ADMIN_NAME=""
#
# NOTA: para que el rol tambien se replique al perfil de users-service (lo que
# lista el panel) hace falta INTERNAL_SERVICE_TOKEN seteado en LOS DOS
# servicios. Sin el, el admin funciona igual (el gateway lee el rol del JWT)
# pero el panel lo muestra con el rol viejo, y auth-service reintenta la
# replicacion en cada arranque hasta que salga.
