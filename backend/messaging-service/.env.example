PORT=3004

# Local: una base por servicio, schema public.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/davinci_messaging?schema=public"

# Railway: UNA sola base compartida y un schema de Postgres por servicio.
# El schema NO hace falta crearlo a mano: `prisma migrate deploy` lo crea si no
# existe, y el enum RequestStatus queda dentro de ese schema (verificado).
# DATABASE_URL="postgresql://<user>:<pass>@<host>:<port>/railway?schema=messaging"

FRONTEND_URL="http://localhost:3000"

# Cupo de escritura por usuario (rate-limit.guard.ts). Cada alta y cada mensaje
# generan una notificacion en la bandeja de otra persona; estos son los topes.
MSG_RATE_REQUESTS_PER_HOUR=10
MSG_RATE_REQUESTS_PER_DAY=40
MSG_RATE_REQUESTS_PER_OWNER_PER_DAY=5
MSG_RATE_MESSAGES_PER_MINUTE=20
MSG_RATE_MESSAGES_PER_HOUR=300
