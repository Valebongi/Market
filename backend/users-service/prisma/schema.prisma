generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  asset_owner
  entrepreneur
}

/// `pending_verification` se retiro: el MVP no verifica email, nada lo escribia
/// ni lo leia, y `UpdateStatusDto` ya solo aceptaba active|suspended.
enum UserStatus {
  active
  suspended
}

model UserProfile {
  id           String     @id @default(uuid())
  userId       String     @unique @map("user_id")
  role         UserRole   @default(entrepreneur)
  status       UserStatus @default(active)
  displayName  String     @map("display_name")
  bio          String?
  avatarUrl    String?    @map("avatar_url")
  contactEmail String?    @map("contact_email")
  website      String?
  location     String?
  linkedin     String?
  twitter      String?
  github       String?
  /// SIN ESCRITOR. Se disenaron para que assets-service y messaging-service los
  /// mantuvieran, pero el MVP no tiene llamadas cruzadas y los endpoints que los
  /// incrementaban (`PATCH /users/:userId/{asset-count,license-count}`) nunca
  /// tuvieron un solo llamador — se retiraron. Valen 0 para todos los usuarios.
  /// Las columnas quedan porque el panel de admin las MUESTRA (mostrando 0);
  /// o se cablean o se retiran junto con el frontend. Ver reporte.
  assetCount   Int        @default(0) @map("asset_count")
  licenseCount Int        @default(0) @map("license_count")
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  notificationSettings NotificationSettings?
  savedAssets          SavedAsset[]

  @@map("user_profiles")
}

model SavedAsset {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  assetId   String      @map("asset_id")
  createdAt DateTime    @default(now()) @map("created_at")

  profile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, assetId])
  @@map("saved_assets")
}

model NotificationSettings {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  emailRequests   Boolean @default(true) @map("email_requests")
  emailMessages   Boolean @default(true) @map("email_messages")
  emailMarketing  Boolean @default(false) @map("email_marketing")
  emailDigest     Boolean @default(true) @map("email_digest")
  emailSecurity   Boolean @default(true) @map("email_security")

  profile UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("notification_settings")
}
