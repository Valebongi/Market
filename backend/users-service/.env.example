PORT=3003
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/davinci_users?schema=public"
FRONTEND_URL="http://localhost:3000"

# Secreto compartido con auth-service para la unica llamada servicio-a-servicio
# (POST /api/v1/users/profiles). Mismo valor que en auth-service.
# Si esta seteado, el endpoint EXIGE el header `x-internal-token`; setearlo
# primero en auth-service o la sincronizacion de perfiles queda rechazada.
# Si esta vacio, el endpoint rechaza toda request que traiga headers x-user-*.
INTERNAL_SERVICE_TOKEN=""

# NOTA sobre el bootstrap del primer admin (implementado en auth-service):
# la promocion del perfil a `role=admin` viaja por POST /users/profiles con el
# flag `bootstrapAdmin`, y ESTE servicio lo rechaza salvo que
# INTERNAL_SERVICE_TOKEN de arriba este seteado (falla cerrado: en modo backstop
# el flag no se acepta). Si no lo vas a usar, el admin igual funciona — solo
# queda el listado del panel mostrando el rol viejo.
