generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetStatus {
  draft
  published
  flagged
  archived
}

enum AssetType {
  software
  design
  business_model
  content
  brand
  project
  other
}

enum LicenseType {
  exclusive
  non_exclusive
  temporary
}

model Asset {
  id            String      @id @default(uuid())
  ownerId       String      @map("owner_id")
  title         String
  slug          String      @unique
  description   String
  category      AssetType
  licenseType   LicenseType @map("license_type")
  pricingType   String      @map("pricing_type") // "fixed" | "negotiable" | "free"
  price         Decimal?    @db.Decimal(10, 2)
  currency      String      @default("USD")
  territory     String      @default("Mundial")
  duration      String?
  coverImageUrl String?     @map("cover_image_url")
  allowedUses   String[]    @map("allowed_uses")
  restrictions  String[]
  status        AssetStatus @default(draft)
  viewCount     Int         @default(0) @map("view_count")
  requestCount  Int         @default(0) @map("request_count")
  publishedAt   DateTime?   @map("published_at")
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tags        AssetTag[]
  attachments AssetAttachment[]
  links       AssetLink[]
  flags       AssetFlag[]

  // Indices de lectura. Postgres NO crea indices para claves foraneas ni para
  // las columnas que se filtran: sin estos, cada listado publico es un seq scan.
  //   [status, deletedAt, createdAt] -> GET /assets (deleted_at IS NULL + status + orden por fecha)
  //   [ownerId, status]              -> dashboard del titular (mis activos por estado)
  //   [category]                     -> filtro por categoria del marketplace
  @@index([status, deletedAt, createdAt])
  @@index([ownerId, status])
  @@index([category])
  @@map("assets")
}

model AssetTag {
  id      String @id @default(uuid())
  assetId String @map("asset_id")
  tag     String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_tags")
}

model AssetAttachment {
  id        String   @id @default(uuid())
  assetId   String   @map("asset_id")
  fileName  String   @map("file_name")
  fileUrl   String   @map("file_url")
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_attachments")
}

model AssetLink {
  id      String  @id @default(uuid())
  assetId String  @map("asset_id")
  label   String
  url     String
  isMain  Boolean @default(false) @map("is_main")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_links")
}

model AssetFlag {
  id        String   @id @default(uuid())
  assetId   String   @map("asset_id")
  reportedBy String  @map("reported_by")
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // El conteo de flags sin resolver filtra por (asset_id, resolved).
  @@index([assetId, resolved])
  @@map("asset_flags")
}
