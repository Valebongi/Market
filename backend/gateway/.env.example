PORT=8080
# Orígenes permitidos por CORS. Acepta UNA lista separada por comas para servir
# el mismo gateway desde varios hosts a la vez (dominio propio + el de Railway,
# que queda de respaldo si el DNS del dominio propio falla).
#   FRONTEND_URL="https://vinciinventa.com,https://frontend-production-ed47.up.railway.app"
# Lista explícita: sin wildcards ni patrones. Se recortan espacios, se ignoran las
# entradas vacías y se saca la barra final (el header Origin nunca la lleva).
FRONTEND_URL="http://localhost:3000"

# JWT (must match auth-service)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_min_32_random_characters"
JWT_EXPIRES_IN="7d"

# Rate limiting (aplicado por GatewayThrottlerGuard, registrado como APP_GUARD)
# Límite general: por IP y por grupo de rutas (/auth/*, /assets/*, /users/*, ...)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Límite estricto SOLO para /auth/login, /auth/register, /auth/forgot-password
# y /auth/reset-password (anti fuerza bruta). Cupo independiente del general.
RATE_LIMIT_AUTH_TTL=60000
RATE_LIMIT_AUTH_MAX=5

# IPs exentas del rate limiting, separadas por coma. Necesario para el server de
# Next.js: los Server Components hacen fetch al gateway y todos los visitantes
# saldrían con una sola IP. Dejar vacío si el frontend solo llama desde el browser.
RATE_LIMIT_TRUSTED_IPS=""

# trust proxy de Express. Necesario si hay nginx/Caddy delante, si no todas las
# requests se ven con la IP del proxy. NO activarlo sin un proxy real delante:
# permitiría falsear X-Forwarded-For y esquivar el límite.
#   ausente | false | 0  -> desactivado (default)
#   1 | 2 | ...          -> cantidad de proxies de confianza (lo normal: 1)
#   loopback | CIDRs     -> lista que interpreta Express
TRUST_PROXY=0

# GET /health queda siempre fuera del rate limiting (load balancers).

# Downstream services
AUTH_SERVICE_URL="http://localhost:3001"
ASSETS_SERVICE_URL="http://localhost:3002"
USERS_SERVICE_URL="http://localhost:3003"
MESSAGING_SERVICE_URL="http://localhost:3004"
DOMAINS_SERVICE_URL="http://localhost:3005"
ADMIN_SERVICE_URL="http://localhost:3006"
