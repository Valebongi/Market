PORT=8080
FRONTEND_URL="http://localhost:3000"

# JWT (must match auth-service)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_min_32_random_characters"
JWT_EXPIRES_IN="7d"

# Rate limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Downstream services
AUTH_SERVICE_URL="http://localhost:3001"
ASSETS_SERVICE_URL="http://localhost:3002"
USERS_SERVICE_URL="http://localhost:3003"
MESSAGING_SERVICE_URL="http://localhost:3004"
DOMAINS_SERVICE_URL="http://localhost:3005"
ADMIN_SERVICE_URL="http://localhost:3006"
