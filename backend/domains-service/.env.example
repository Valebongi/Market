PORT=3005
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/davinci_domains?schema=public"
FRONTEND_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Precios de referencia
# ─────────────────────────────────────────────────────────────────────────────
# Los precios salen de la lista pública de Porkbun
# (POST https://api.porkbun.com/api/json/v3/pricing/get), que NO pide API key.
# No hay nada que configurar para que funcione. Poner en "false" apaga los
# precios y el servicio responde `pricing: null` en todos los resultados.
# DOMAINS_PRICING_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Comparativo entre registradores
# ─────────────────────────────────────────────────────────────────────────────
# Con "true" (default) cada dominio disponible trae dos opciones: Namecheap
# (el registrador afiliado, sin precio publicado porque su API pide key) y
# Porkbun (con precio real).
#
# DECISIÓN DE NEGOCIO: mostrar Porkbun con precio al lado de Namecheap sin
# precio empuja el click hacia Porkbun, que discontinuó su programa de
# afiliados. O sea que ese click no es "todavía no monetizado": es plata que no
# se puede cobrar nunca. Es información honesta para el usuario y plata menos
# para nosotros. Está en una variable justamente para que se pueda apagar sin
# deploy si el dueño prefiere proteger la atribución.
# DOMAINS_COMPARE_REGISTRARS=true

# ─────────────────────────────────────────────────────────────────────────────
# Afiliación — todavía SIN ID de afiliado
# ─────────────────────────────────────────────────────────────────────────────
# Sin esta variable el deep link sale limpio y funciona igual; lo único que se
# pierde es la comisión. Es la variable más rentable del proyecto: todo lo
# demás (deep link al carrito, precios, sugerencias) ya está construido.
#
# Namecheap afilia por IMPACT (impact.com). Verificado en namecheap.com/affiliates:
# sólo nombra Impact y Commission Junction. NO usa ShareASale.
#
# Probado de punta a punta con un ID de relleno: el wrapper de Impact conserva
# el deep link y el dominio llega igual al carrito, con el tracking agregado.
# Reemplazar <TU_IMPACT_ID> por el ID que den al dar de alta el programa:
# NAMECHEAP_AFFILIATE_URL_TEMPLATE="https://namecheap.pxf.io/c/<TU_IMPACT_ID>/386170/5618?u={url}"
#
# Si se eligiera Commission Junction en vez de Impact: CJ concatena el destino
# SIN encodear, así que no entra en este template y hay que tocar
# `applyAffiliate()` en registrars.ts.
#
# Porkbun NO tiene programa de afiliados: porkbun.com/affiliate dice "The
# affiliate program has been discontinued". Por eso no hay variable para
# Porkbun y no la va a haber.
