PORT=3005
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/davinci_domains?schema=public"
FRONTEND_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Cuota de consultas RDAP salientes, por usuario y por hora
# ─────────────────────────────────────────────────────────────────────────────
# (La lee lookup-quota.ts; default 300 si está vacía o no es un entero > 0.)
#
# Existe por el factor de amplificación: una búsqueda dispara hasta 18 consultas
# a rdap.org, así que las 100 req/min por IP del gateway se convierten en ~1.800
# req/min salientes desde una sola IP sin pasarse de ningún límite nuestro.
# rdap.org es un servicio público gratuito sin contrato: si nos banean, la
# feature entera se apaga y con ella el único canal de monetización del servicio.
#
# Se debita lo que REALMENTE salió a la red (sin los cache hits), no las
# búsquedas. Un usuario real explorando hace 5-10 búsquedas seguidas (~60-180
# consultas); 300 le sobra y corta el loop automatizado.
#
# OJO: el contador es EN MEMORIA, o sea por instancia. Con N réplicas la cuota
# efectiva es N veces esta. Con una sola instancia (el MVP) es exacto.
# DOMAINS_USER_LOOKUP_QUOTA=300

# ─────────────────────────────────────────────────────────────────────────────
# Precios de referencia
# ─────────────────────────────────────────────────────────────────────────────
# Los precios salen de la lista pública de Porkbun
# (POST https://api.porkbun.com/api/json/v3/pricing/get), que NO pide API key.
# No hay nada que configurar para que funcione. Poner en "false" apaga los
# precios y el servicio responde `pricing: null` en todos los resultados.
# DOMAINS_PRICING_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# A dónde apunta el link de compra
# ─────────────────────────────────────────────────────────────────────────────
# DOMAINS_LINK_TARGET=search|cart   (default: search)
#
#   search  Página de resultados del registrador PARA ESE DOMINIO.
#           Namecheap: https://www.namecheap.com/domains/registration/results/?domain=<dominio>
#           El usuario ve la fila del dominio con precio y un botón "Add to
#           cart". Le queda un click más que con un carrito precargado.
#
#   cart    Carrito del registrador supuestamente precargado con el dominio.
#           Namecheap: https://www.namecheap.com/cart/?domains=<dominio>
#           HOY NO FUNCIONA. Ver abajo. Elegirlo deja un warning en el log.
#
# ── Por qué el default es `search` ───────────────────────────────────────────
# Porque `cart` está medido y roto. Namecheap IGNORA el parámetro `?domains=`:
# devuelve 200 y redirige a /cart/customize/addons.aspx, pero el HTML que sirve
# es idéntico al del carrito SIN parámetro (sólo cambian el `action` del form,
# los nonces de ASP.NET y un GUID de CMS). Renderizado en Chrome headless, el
# texto visible dice "Your Cart · Subtotal $0.00" y el dominio no aparece por
# ningún lado: el carrito está VACÍO. Es exactamente la landing genérica que
# hay que evitar, y encima disfrazada de carrito.
#
# `search`, en cambio, renderiza "<dominio> · $11.08/yr · Add to cart", aguanta
# `Accept-Language: es-AR` sin redirigir a nada regional, sobrevive al wrapper
# de afiliación de Impact (el dominio llega igual, con el tracking agregado) y
# degrada bien si el dominio se registró entre la búsqueda y el click: muestra
# "Registered in 1997 · Make offer" para ESE dominio, no una landing.
#
# `cart` queda implementado igual porque el destino es una decisión de negocio
# y porque, si Namecheap arregla el parámetro, se vuelve cambiando esta línea
# en vez de con un deploy. Antes de prenderlo, re-verificar con:
#   chrome --headless=new --user-agent="<UA de Chrome real>" \
#          --virtual-time-budget=30000 --dump-dom "<url>"
# y confirmar que el dominio está en el TEXTO VISIBLE. El HTML crudo NO sirve:
# la página es una SPA y el dominio aparece ahí sólo como eco del query string.
#
# Porkbun no tiene deep link de carrito verificado, así que con cualquiera de
# los dos valores usa su página de resultados, que ya es específica del dominio.
# DOMAINS_LINK_TARGET=search

# ─────────────────────────────────────────────────────────────────────────────
# Salvaguarda: sin destino específico, no hay link
# ─────────────────────────────────────────────────────────────────────────────
# No se configura, pero conviene saber que existe. Un click que termina en una
# página genérica es peor que ningún click: el usuario tiene que volver a
# tipear el dominio. Así que cuando no se puede construir un destino específico
# para un TLD, el servicio NO emite oferta para ese registrador.
#
# El caso real: RDAP contesta "disponible" para TLDs que Namecheap no vende
# (`.bank`, `.ar`, los IDN en punycode), y ahí Namecheap muestra "Unsupported
# TLD". `NAMECHEAP_TLDS` en `registrars.ts` es la lista verificada de TLDs que
# sí vende; lo que quede afuera no genera link.
#
# CONSECUENCIA PARA LA UI: `available: true` ya no garantiza `registrarUrl`.
# Un dominio disponible puede venir con `registrarUrl: null` y `offers: []`.
# Si se agrega un TLD a DEFAULT_EXTENSIONS o a suggestions.ts, hay que
# verificarlo y sumarlo a NAMECHEAP_TLDS o el link se deja de emitir.

# ─────────────────────────────────────────────────────────────────────────────
# Comparativo entre registradores
# ─────────────────────────────────────────────────────────────────────────────
# Con "true" (default) cada dominio disponible trae dos opciones: Namecheap
# (el registrador afiliado, sin precio publicado porque su API pide key) y
# Porkbun (con precio real).
#
# DECISIÓN DE NEGOCIO: mostrar Porkbun con precio al lado de Namecheap sin
# precio empuja el click hacia Porkbun, que discontinuó su programa de
# afiliados. O sea que ese click no es "todavía no monetizado": es plata que no
# se puede cobrar nunca. Es información honesta para el usuario y plata menos
# para nosotros. Está en una variable justamente para que se pueda apagar sin
# deploy si el dueño prefiere proteger la atribución.
# DOMAINS_COMPARE_REGISTRARS=true

# ─────────────────────────────────────────────────────────────────────────────
# Afiliación — todavía SIN ID de afiliado
# ─────────────────────────────────────────────────────────────────────────────
# Sin esta variable el deep link sale limpio y funciona igual; lo único que se
# pierde es la comisión. Es la variable más rentable del proyecto: todo lo
# demás (deep link específico del dominio, precios, sugerencias) ya está
# construido.
#
# Namecheap afilia por IMPACT (impact.com). Verificado en namecheap.com/affiliates:
# sólo nombra Impact y Commission Junction. NO usa ShareASale.
#
# Probado de punta a punta con un ID de relleno: el wrapper de Impact conserva
# el deep link y el dominio llega igual a la página de resultados, con el
# tracking agregado. Verificado sobre el destino `search`.
# Reemplazar <TU_IMPACT_ID> por el ID que den al dar de alta el programa:
# NAMECHEAP_AFFILIATE_URL_TEMPLATE="https://namecheap.pxf.io/c/<TU_IMPACT_ID>/386170/5618?u={url}"
#
# Si se eligiera Commission Junction en vez de Impact: CJ concatena el destino
# SIN encodear, así que no entra en este template y hay que tocar
# `applyAffiliate()` en registrars.ts.
#
# Porkbun NO tiene programa de afiliados: porkbun.com/affiliate dice "The
# affiliate program has been discontinued". Por eso no hay variable para
# Porkbun y no la va a haber.
