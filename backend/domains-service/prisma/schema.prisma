generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DomainSearch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  query     String
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  // `getHistory` y `pruneHistory` filtran por usuario y ordenan por fecha, y la
  // tabla no tenia indice: cada consulta de historial era un scan completo
  // sobre una tabla que crecia sin techo. El indice compuesto sirve a las dos.
  @@index([userId, createdAt])
  @@map("domain_searches")
}
