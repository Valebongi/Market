generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModerationAction {
  approved
  rejected
  flagged
  restored
}

model ModerationLog {
  id         String           @id @default(uuid())
  assetId    String           @map("asset_id")
  assetTitle String           @map("asset_title")
  adminId    String           @map("admin_id")
  action     ModerationAction
  notes      String?
  createdAt  DateTime         @default(now()) @map("created_at")

  // La tabla de auditoria se consulta SIEMPRE filtrada y ordenada por fecha, y
  // no tenia un solo indice: cada `GET /admin/moderation/logs` era un scan
  // completo. Con `page` sin tope en el DTO, un `?page=999999999` forzaba ese
  // scan entero para devolver cero filas. La auditoria tiene que seguir
  // respondiendo justo cuando alguien la esta atacando.
  @@index([createdAt])
  @@index([assetId])
  @@index([adminId])
  @@index([action])
  @@map("moderation_logs")
}

model MetricSnapshot {
  id              String   @id @default(uuid())
  date            DateTime @unique @db.Date
  totalUsers      Int      @default(0) @map("total_users")
  newUsers        Int      @default(0) @map("new_users")
  totalAssets     Int      @default(0) @map("total_assets")
  publishedAssets Int      @default(0) @map("published_assets")
  totalRequests   Int      @default(0) @map("total_requests")
  closedRequests  Int      @default(0) @map("closed_requests")
  totalViews      Int      @default(0) @map("total_views")
  createdAt       DateTime @default(now()) @map("created_at")

  // Quien escribio esta fila, y cuando fue la ULTIMA vez.
  //
  // `recordSnapshot` es un UPSERT por fecha: cualquier admin puede pisar el
  // snapshot de hoy con los numeros que quiera, las veces que quiera, y hasta
  // ahora eso no dejaba ningun rastro — ni quien, ni cuando, ni que habia
  // antes. Las metricas del negocio son la base de las decisiones de producto
  // y de lo que se le muestra a un inversor: falsearlas era gratis y anonimo.
  //
  // Esto no impide el upsert (que es el comportamiento deseado: un snapshot
  // por dia que se refresca), pero lo hace atribuible.
  //
  // `recordedBy` es NULLABLE a proposito: las filas que ya existen no tienen
  // autor conocido y rellenarlas con un valor inventado seria exactamente el
  // problema que esta columna viene a resolver. NULL = "escrita antes de que
  // hubiera atribucion".
  recordedBy      String?  @map("recorded_by")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("metric_snapshots")
}
